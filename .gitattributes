* text=auto

# C# / 文本：统一 LF，避免跨平台 diff 噪音
*.cs text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.asmdef text eol=lf

# Unity 文本资源
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.exe binary
*.zip binary
